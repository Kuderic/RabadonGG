# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Environment
.env
.env.*
!.env.example
!.env.desktop        # non-secret desktop build vars (VITE_DESKTOP, VITE_API_BASE_URL)

# Generated lolalytics cache (patch-keyed JSON, re-fetched as needed)
backend/data/lolalytics/

# SQLite cache database
backend/data/*.db

# Logs
*.log
*.err

# MCP / editor tool configs (machine-specific)
.mcp.json

# Claude Code subagent worktrees (temporary, never committed)
.claude/worktrees/

# Playwright test artifacts and screenshots dumped at repo root
.playwright-mcp/
[0-9][0-9]-*.png
[0-9][0-9]-*.md

# Rust / Tauri build output
desktop/src-tauri/target/
desktop/build/
desktop/src-tauri/binaries/

# IDE
.vscode/
.idea/
