{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rabadon",
  "identifier": "gg.rabadon.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../frontend && npm run build -- --mode desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rabadon.GG",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true,
        "decorations": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "",
        "url": "index.html?mode=overlay",
        "width": 320,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "x": 1580,
        "y": 120,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0RTUzODk5MEIxRUY1MjcKUldRbjlSNExtVGpsRkR5WGcxZmZRRVM4WXZnSytXZzhPaWpKNHZvR3VaUE5McGFCdnVxeFZtd0MK",
      "endpoints": [
        "https://github.com/Kuderic/RabadonGG/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
