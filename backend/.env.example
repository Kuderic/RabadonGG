# Backend environment variables
# Copy to .env and fill in values — never commit .env

# Environment
ENV=development

# Allowed frontend origins for CORS.
# Development: leave unset — defaults to localhost:5173/5174/3000
# Production:  set to your domain(s), comma-separated
# ALLOWED_ORIGINS=https://rabadon.gg,https://www.rabadon.gg

# (Future) Anthropic API key for LLM synthesis
# ANTHROPIC_API_KEY=sk-...

# (Future) Riot API key for own stat pipeline
# RIOT_API_KEY=...
