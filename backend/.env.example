# Backend environment variables (copy to .env and fill in values)

# Redis cache URL
REDIS_URL=redis://localhost:6379/0

# Environment (development or production)
ENV=development

# (Future) Anthropic API key for LLM synthesis
# ANTHROPIC_API_KEY=sk-...

# (Future) Supabase credentials
# SUPABASE_URL=https://...
# SUPABASE_KEY=...

# (Future) Riot API key for own stat pipeline
# RIOT_API_KEY=...
